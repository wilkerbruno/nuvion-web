# Copie para .env e preencha os valores reais. NUNCA commite o .env.
#
# IMPORTANTE: o app desktop original tinha usuário/senha do MySQL de
# produção e senha de app do Gmail hardcoded em utils/config_manager.py,
# versionados no Git. Recomendação: rotacionar essas credenciais antes de
# ligar este backend em produção — elas já estão expostas no histórico do
# repositório desktop.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Banco de dados ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nuvion
DB_USER=changeme
DB_PASSWORD=changeme

# --- Autenticação (gere um valor novo, ex.: `openssl rand -hex 32`) ---
JWT_SECRET_KEY=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Criptografia de credenciais de IA (Fase 4) ---
# Chave Fernet para cifrar usuário/senha de login direto salvos em
# AIDirectCredentials. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
EXTENSION_ID=

# --- Mercado Pago (Fase 3) ---
# Fallback/seed inicial só — quem manda de verdade é PaymentConfig no banco
# (editável por admin em PUT /admin/payment-config, sem precisar redeploy).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_APP_ID=
# Segredo do webhook (assinatura HMAC do header x-signature) — opcional,
# mas recomendado em produção. Configure o mesmo valor no painel do
# Mercado Pago ao cadastrar a URL do webhook.
MERCADOPAGO_WEBHOOK_SECRET=

# --- USDT / TRC20 (pagamento cripto self-custodial) ---
# Opcional — sem ela, a API pública do TronGrid ainda funciona, só com
# limite de taxa menor. Gere uma gratuita em https://www.trongrid.io/.
# A carteira que recebe os pagamentos é configurada via
# PUT /admin/payment-config (usdt_wallet_address), não aqui.
TRONGRID_API_KEY=

# --- SMTP (recuperação de senha, notificações por e-mail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER_NAME=Nuvion Browser
